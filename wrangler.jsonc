// Cloudflare Workers. Cloudflare panelinde bu repo bağlı; main'e her push'ta site güncellenir.
// /api/* istekleri src/worker.js'e, diğer her şey site/ klasöründeki statik dosyalara gider.
{
  "name": "hissetakip",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
